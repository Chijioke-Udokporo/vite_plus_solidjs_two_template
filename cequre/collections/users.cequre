collection users {
  auth: true;

  fields: {
    name: text;
    email: email @unique;
    password: password;
    role: select("admin", "user") @default("user");
  }

  access: {
    read: user.id == data.id || user.role == "admin";
    create: true;
    update: user.id == data.id || user.role == "admin";
    delete: user.role == "admin";
  }
}
