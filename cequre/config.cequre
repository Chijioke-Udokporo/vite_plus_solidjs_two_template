config {
	output: "_generated";
	migrate {
		dropOrphan: true;
		alterColumns: true;
	}
	core: {
		api: {
			prefix: "/api";
		}
		graphql {
			enabled: true;
			path: "/graphql";
		}
	}
	security: {
		cors: {
			origin: [env("APP_ORIGIN")];
			credentials: true;
		}
		auth {
			strategies: ["jwt"];
			jwt: {
				accessTokenExpiry: "15m";
				refreshTokenExpiry: "7d";
			}
			lockout: {
				maxAttempts: 5;
				durationMinutes: 15;
			}
		}
		rateLimit: {
			login: {
				max: 5;
				window: "15m";
			}
			write: {
				max: 100;
				window: "1m";
			}
		}
		audit: {
			enabled: true;
		}
		upload: {
			visibility: "private";
		}
	}
	monitoring: {
		enabled: true;
		apiKey: env("MONITORING_API_KEY");
		healthCheck: {
			path: "/health";
		}
	}
	adminUi: {
		collection: "admins";
	}
}
