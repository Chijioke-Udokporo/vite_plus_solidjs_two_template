config {
  output: "_generated";

  core: {
    api: {
      prefix: "/api";
    };
    graphql: {
      enabled: true;
      playground: true;
      introspection: true;
    };
  };

  security: {
    cors: {
      origin: [env("APP_ORIGIN")];
      credentials: true;
    };
    auth: {
      strategies: ["jwt"];
      jwt: {
        accessTokenExpiry: "15m";
        refreshTokenExpiry: "7d";
      };
      mfa: {
        enabled: true;
        enforceForRoles: ["admin", "super"];
      };
      lockout: {
        maxAttempts: 5;
        durationMinutes: 15;
      };
    };
    rateLimit: {
      login: { max: 5; window: "15m"; };
      write: { max: 100; window: "1m"; };
    };
    audit: { enabled: true; };
    upload: { visibility: "authenticated"; };
  };

  monitoring: {
    enabled: true;
    apiKey: env("MONITORING_API_KEY");
    healthCheck: {
      path: "/health";
    }
  };

  adminUi: {
    collection: "admins";
  };
}
